# Copy this file to .env.local (git-ignored) and fill in values.
# The browser never sees these; only the local API server (services/api) reads them.

# Local API server port (Vite proxies /api/* here)
API_PORT=8787

# Needed from M5 (exact token counting) and M7 (AI rewrite, paid)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Hard daily spend cap for the paid AI rewrite, in USD (M7)
REWRITE_DAILY_CAP_USD=2
