# Copy this file to .env.local (git-ignored) and fill in values.
# The browser never sees these; only the local API server (services/api) reads them.
# Every key is optional: without it, that feature is switched off and the UI says so.

# Local API server port (Vite proxies /api/* here)
API_PORT=8787

# Exact token counts for Claude (free count_tokens endpoint) AND the paid AI rewrite.
ANTHROPIC_API_KEY=
# Exact token counts for Gemini (free countTokens endpoint).
GEMINI_API_KEY=

# Paid AI rewrite: hard daily spend cap in USD, the Claude model, and its effort level.
REWRITE_DAILY_CAP_USD=2
REWRITE_MODEL=claude-opus-5
REWRITE_EFFORT=medium
